OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Stripe Checkout para la entrevista comercial de Cluster Podcast.
# La clave restringida del servidor necesita lectura y escritura de Checkout Sessions.
STRIPE_SECRET_KEY=

# Tracking — landings verticales (opcional)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# CRM de Cluster Podcast. Si está vacío, usa CONTACT_WEBHOOK_URL o email.
PODCAST_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
# Acuerdo privado de proveedores (doble opt-in por correo): requiere RESEND_API_KEY y un
# CONTACT_FROM_EMAIL de dominio verificado en Resend, porque se le escribe al proveedor.
# Webhook opcional: recibe la respuesta ya confirmada. Si está vacío, usa CONTACT_WEBHOOK_URL.
SUPPLIER_AGREEMENT_WEBHOOK_URL=
# Proveedores confirmados: contacto, etiquetas y nota en GoHighLevel (API v2, token privado).
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# CRM de selección (/postulaciones)
# Admins que aprueban accesos: leandromatiasdgonz@gmail.com, info@cluster.marketing
# Extra owners (comma-separated) also get approval rights
CAREERS_ADMIN_EMAILS=
CAREERS_AUTH_SECRET=

# Blob (Vercel a veces exporta BLOB_READ_WRITE_TOKEN_READ_WRITE_TOKEN)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
