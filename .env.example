OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Stripe Checkout para la entrevista comercial de Cluster Podcast.
# La clave restringida del servidor necesita lectura y escritura de Checkout Sessions.
STRIPE_SECRET_KEY=

# Tracking — landings verticales (opcional)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# CRM de Cluster Podcast. Si está vacío, usa CONTACT_WEBHOOK_URL o email.
PODCAST_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
# Captcha propio de contacto: secreto aleatorio estable (mínimo 32 bytes).
# Si se omite, usa RESEND_API_KEY, CAREERS_AUTH_SECRET o STRIPE_SECRET_KEY.
CONTACT_CAPTCHA_SECRET=
# Acuerdo privado de proveedores (doble opt-in por correo): requiere RESEND_API_KEY y un
# CONTACT_FROM_EMAIL de dominio verificado en Resend, porque se le escribe al proveedor.
# Webhook opcional: recibe la respuesta ya confirmada. Si está vacío, usa CONTACT_WEBHOOK_URL.
SUPPLIER_AGREEMENT_WEBHOOK_URL=
# Proveedores confirmados: contacto, etiquetas y nota en GoHighLevel (API v2, token privado).
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# CRM de Cluster en /dashboard. En Vercel el acceso sale del conector neon/clustercrm
# (getToken con subject app). En local, vercel env pull deja VERCEL_OIDC_TOKEN.
# DATABASE_URL solo hace falta si ese conector no está disponible.
DATABASE_URL=
# En local, si el conector todavía no tiene la clave real, pega aquí la API key de Neon (napi_…).
NEON_API_KEY=
# El CRM exige inicio de sesión. El administrador es leandromatiasgonz@gmail.com.
# Correos extra, separados por coma.
DASHBOARD_ALLOWED_EMAILS=
# Academia. Con PayPal o con STRIPE_SECRET_KEY el checkout cobra. Sin ninguna de las dos,
# un curso de pago, la suscripción y las donaciones no se entregan. Lo gratis sí se inscribe.
# Las liquidaciones envían el dinero por PayPal solo cuando estas claves están cargadas.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Bandeja y campañas. El correo usa RESEND_API_KEY. SMS y WhatsApp salen solo con estas claves.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# CRM de selección (/postulaciones)
# Admins que aprueban accesos: leandromatiasdgonz@gmail.com, info@cluster.marketing
# Extra owners (comma-separated) also get approval rights
CAREERS_ADMIN_EMAILS=
CAREERS_AUTH_SECRET=

# Blob (Vercel a veces exporta BLOB_READ_WRITE_TOKEN_READ_WRITE_TOKEN)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
